{
  "rules": {
    ".read": false,
    ".write": false,
    "accounts": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid && (!data.exists() || !newData.exists())",
        "email": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "profile": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "fcmToken": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "fcmTokens": {
          "$installationId": {
            ".write": "auth != null && auth.uid == $uid && (!newData.exists() || newData.child('installationId').val() == $installationId)",
            ".validate": "!newData.exists() || newData.hasChildren(['installationId', 'token', 'platform', 'updatedAt'])",
            "installationId": {
              ".validate": "newData.isString() && newData.val() == $installationId && newData.val().matches(/^[A-Za-z0-9_-]{16,80}$/)"
            },
            "token": {
              ".validate": "newData.isString() && newData.val().length > 20 && newData.val().length <= 4096"
            },
            "platform": {
              ".validate": "newData.isString() && newData.val().matches(/^(android|ios|macos|windows|linux|web|unknown)$/)"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "activeSession": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "!newData.exists() || newData.hasChildren(['installationId', 'sessionId', 'platform', 'activatedAt', 'lastSeenAt'])",
          "installationId": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{16,80}$/)"
          },
          "sessionId": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Fa-f0-9]{32,128}$/)"
          },
          "platform": {
            ".validate": "newData.isString() && newData.val().matches(/^(android|ios|macos|windows|linux|web|unknown)$/)"
          },
          "activatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
          },
          "lastSeenAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        },
        "sessions": {
          "$installationId": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid && newData.exists() && newData.child('installationId').val() == $installationId && newData.child('sessionId').isString() && ((root.child('accounts').child($uid).child('activeSession').child('installationId').val() == $installationId && root.child('accounts').child($uid).child('activeSession').child('sessionId').val() == newData.child('sessionId').val()) || (data.exists() && data.child('installationId').val() == $installationId && data.child('sessionId').val() == newData.child('sessionId').val() && newData.child('signedIn').val() == false))",
            ".validate": "newData.hasChildren(['installationId', 'sessionId', 'signedIn', 'connected', 'appState', 'platform', 'lastSeenAt'])",
            "installationId": {
              ".validate": "newData.isString() && newData.val() == $installationId && newData.val().matches(/^[A-Za-z0-9_-]{16,80}$/)"
            },
            "sessionId": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Fa-f0-9]{32,128}$/)"
            },
            "signedIn": {
              ".validate": "newData.isBoolean()"
            },
            "connected": {
              ".validate": "newData.isBoolean()"
            },
            "appState": {
              ".validate": "newData.isString() && newData.val().matches(/^(foreground|inactive|background|detached|background_event|signed_out)$/)"
            },
            "platform": {
              ".validate": "newData.isString() && newData.val().matches(/^(android|ios|macos|windows|linux|web|unknown)$/)"
            },
            "lastSeenAt": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
            },
            "lastLoginAt": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
            },
            "signedOutAt": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "homePresence": {
          "$homeId": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid && ((!newData.exists() && data.exists() && root.child('accounts').child($uid).child('activeSession').child('installationId').val() == data.child('installationId').val() && root.child('accounts').child($uid).child('activeSession').child('sessionId').val() == data.child('sessionId').val()) || (newData.exists() && newData.child('installationId').isString() && newData.child('sessionId').isString() && root.child('accounts').child($uid).child('activeSession').child('installationId').val() == newData.child('installationId').val() && root.child('accounts').child($uid).child('activeSession').child('sessionId').val() == newData.child('sessionId').val()))",
            ".validate": "!newData.exists() || newData.hasChildren(['ownerUid', 'homeId', 'installationId', 'sessionId'])",
            "ownerUid": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
            },
            "homeId": {
              ".validate": "newData.isString() && newData.val() == $homeId && newData.val().length > 0 && newData.val().length <= 128"
            },
            "installationId": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{16,80}$/)"
            },
            "sessionId": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Fa-f0-9]{32,128}$/)"
            },
            "state": {
              ".validate": "newData.isString() && newData.val().matches(/^(inside|outside|unknown)$/)"
            },
            "event": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
            },
            "source": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
            },
            "lastConfirmedAt": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
            },
            "lastEventOccurredAt": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
            },
            "lastTransitionAt": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
            },
            "lastLocationCheckAt": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
            },
            "monitoringCheckedAt": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
            },
            "monitoringEligible": {
              ".validate": "newData.isBoolean()"
            },
            "monitoringAvailable": {
              ".validate": "newData.isBoolean()"
            },
            "locationAlwaysGranted": {
              ".validate": "newData.isBoolean()"
            },
            "batteryUnrestricted": {
              ".validate": "newData.isBoolean()"
            },
            "backgroundRestricted": {
              ".validate": "newData.isBoolean()"
            },
            "autoStartConfirmed": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": true
            }
          }
        },
        "homes": {
          "$homeId": {
            ".read": "auth != null && (auth.uid == $uid || root.child('accounts').child(auth.uid).child('sharedHomes').child($homeId).child('ownerUid').val() == $uid)",
            ".write": "auth != null && (auth.uid == $uid || (root.child('accounts').child(auth.uid).child('sharedHomes').child($homeId).child('ownerUid').val() == $uid && root.child('accounts').child(auth.uid).child('sharedHomes').child($homeId).child('role').val() == 'admin') || (!newData.exists() && root.child('accounts').child(auth.uid).child('homes').child($homeId).child('_ownerUid').val() == auth.uid && data.child('_ownerUid').val() == $uid))",
            "events": {
              ".indexOn": ["time"],
              "$eventId": {
                ".write": "auth != null && (auth.uid == $uid || ((newData.child('senderUid').val() == auth.uid || data.child('senderUid').val() == auth.uid) && root.child('accounts').child(auth.uid).child('sharedHomes').child($homeId).child('ownerUid').val() == $uid))"
              }
            }
          }
        },
        "homeOrder": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "alarmSettings": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "groupNames": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "shareRequests": {
          "$requestId": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && (auth.uid == $uid || newData.child('ownerUid').val() == auth.uid || newData.child('targetUid').val() == auth.uid || (newData.exists() && newData.child('homeId').exists() && newData.child('ownerUid').exists() && root.child('accounts').child(auth.uid).child('sharedHomes').child(newData.child('homeId').val()).child('ownerUid').val() == newData.child('ownerUid').val() && root.child('accounts').child(auth.uid).child('sharedHomes').child(newData.child('homeId').val()).child('role').val() == 'admin') || data.child('ownerUid').val() == auth.uid || data.child('targetUid').val() == auth.uid || (!newData.exists() && data.child('homeId').exists() && data.child('ownerUid').exists() && root.child('accounts').child(auth.uid).child('sharedHomes').child(data.child('homeId').val()).child('ownerUid').val() == data.child('ownerUid').val() && root.child('accounts').child(auth.uid).child('sharedHomes').child(data.child('homeId').val()).child('role').val() == 'admin'))"
          }
        },
        "sharedHomes": {
          "$homeId": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && (root.child('accounts').child(auth.uid).child('homes').child($homeId).exists() || (auth.uid == $uid && root.child('accounts').child(auth.uid).child('shareRequests').child($homeId).exists()) || (root.child('accounts').child(auth.uid).child('sharedHomes').child($homeId).child('role').val() == 'admin' && (root.child('accounts').child(auth.uid).child('sharedHomes').child($homeId).child('ownerUid').val() == newData.child('ownerUid').val() || root.child('accounts').child(auth.uid).child('sharedHomes').child($homeId).child('ownerUid').val() == data.child('ownerUid').val())))"
          }
        },
        "shareList": {
          "$homeId": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && ((auth.uid == $uid && root.child('accounts').child(auth.uid).child('homes').child($homeId).exists()) || (root.child('accounts').child(auth.uid).child('sharedHomes').child($homeId).child('ownerUid').val() == $uid && root.child('accounts').child(auth.uid).child('sharedHomes').child($homeId).child('role').val() == 'admin'))"
          }
        },
        "notifications": {
          ".indexOn": ["time"],
          "$notificationId": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && (auth.uid == $uid || newData.child('senderUid').val() == auth.uid || data.child('senderUid').val() == auth.uid)"
          }
        }
      }
    },
    "sharedByHome": {
      "$homeId": {
        ".read": "auth != null && (root.child('accounts').child(auth.uid).child('homes').child($homeId).exists() || root.child('accounts').child(auth.uid).child('sharedHomes').child($homeId).exists() || data.child(auth.uid).exists())",
        "$memberUid": {
          ".write": "auth != null && (root.child('accounts').child(auth.uid).child('homes').child($homeId).exists() || root.child('accounts').child(auth.uid).child('sharedHomes').child($homeId).child('role').val() == 'admin' || (auth.uid == $memberUid && root.child('accounts').child(auth.uid).child('shareRequests').child($homeId).exists()))"
        }
      }
    },
    "homeChats": {
      "$homeId": {
        ".read": "auth != null && (root.child('accounts').child(auth.uid).child('homes').child($homeId).exists() || root.child('accounts').child(auth.uid).child('sharedHomes').child($homeId).exists())",
        "messages": {
          "$messageId": {
            ".write": "auth != null && !data.exists() && newData.exists() && (root.child('accounts').child(auth.uid).child('homes').child($homeId).exists() || root.child('accounts').child(auth.uid).child('sharedHomes').child($homeId).exists()) && newData.child('uid').val() == auth.uid",
            ".validate": "newData.hasChildren(['uid', 'text', 'time'])",
            "uid": {
              ".validate": "newData.isString() && newData.val() == auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "photoUrl": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
            },
            "time": {
              ".validate": "newData.isNumber() && newData.val() <= now + 1000 && newData.val() >= now - 300000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "lastRead": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && newData.exists() && (root.child('accounts').child(auth.uid).child('homes').child($homeId).exists() || root.child('accounts').child(auth.uid).child('sharedHomes').child($homeId).exists())",
            ".validate": "newData.isNumber() && (newData.val() <= now + 1000) && (newData.val() >= now - 300000) && (!data.exists() || data.val() > now + 1000 || newData.val() >= data.val())"
          }
        },
        "typing": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && (root.child('accounts').child(auth.uid).child('homes').child($homeId).exists() || root.child('accounts').child(auth.uid).child('sharedHomes').child($homeId).exists())",
            ".validate": "!newData.exists() || newData.hasChildren(['name', 'photoUrl', 'updatedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "photoUrl": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 1000 && newData.val() >= now - 300000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "pair_requests": {
      "$requestId": {
        ".read": "auth != null && (data.child('requestedBy').val() == auth.uid || data.child('ownerUid').val() == auth.uid)",
        ".write": "auth != null && newData.child('requestedBy').val() == auth.uid && newData.child('active').val() == true && newData.child('duration').isNumber() && newData.child('duration').val() <= 60 && root.child('accounts').child(newData.child('ownerUid').val()).child('homes').child(newData.child('homeId').val()).exists() && (auth.uid == newData.child('ownerUid').val() || (root.child('accounts').child(auth.uid).child('sharedHomes').child(newData.child('homeId').val()).child('ownerUid').val() == newData.child('ownerUid').val() && root.child('accounts').child(auth.uid).child('sharedHomes').child(newData.child('homeId').val()).child('role').val() == 'admin'))"
      }
    },
    "alarm_pause_requests": {
      "$requestId": {
        ".read": "auth != null && (data.child('createdByUid').val() == auth.uid || data.child('ownerUid').val() == auth.uid || root.child('accounts').child(auth.uid).child('sharedHomes').child(data.child('homeId').val()).child('ownerUid').val() == data.child('ownerUid').val())",
        ".write": "auth != null && !data.exists() && newData.child('status').val() == 'pending' && newData.child('createdByUid').val() == auth.uid && newData.child('ownerUid').isString() && newData.child('homeId').isString() && root.child('accounts').child(newData.child('ownerUid').val()).child('homes').child(newData.child('homeId').val()).exists() && (auth.uid == newData.child('ownerUid').val() || root.child('accounts').child(auth.uid).child('sharedHomes').child(newData.child('homeId').val()).child('ownerUid').val() == newData.child('ownerUid').val()) && (newData.child('action').val() == 'remove' || (newData.child('date').isString() && newData.child('start').isString() && newData.child('end').isString()))"
      }
    }
  }
}
